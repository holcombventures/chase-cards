# Optional — get a free key at https://dev.pokemontcg.io
# Without a key the public API still works, but rate limits are lower.
POKEMONTCG_API_KEY=

# Optional — OPTCG API key (X-API-Key) for https://optcg-api.arjunbansal-ai.workers.dev
# Without it, One Piece English falls back to the public optcgapi.com JSON API.
# Request access: see OPTCG /docs (forms.gle linked from the API landing page).
OPTCG_API_KEY=

# --- Stripe Checkout (see STRIPE.md) ---
# Without STRIPE_SECRET_KEY / price IDs, the shop falls back to demo unlock.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time Prices (Checkout mode=payment). Display labels: src/lib/planPrices.ts.
# Premium — choose one live category — $2.99
STRIPE_PRICE_PREMIUM=
# All Access — $9.99
STRIPE_PRICE_ALL_ACCESS=
# Category add-ons / expansion packs — $1.99 each
STRIPE_PRICE_POKEMON=
STRIPE_PRICE_ONE_PIECE=
STRIPE_PRICE_MTG=
# Optional single Sports product ($1.99); prefer per-sport prices below
STRIPE_PRICE_SPORTS=
# Per-sport add-ons — $1.99 each
STRIPE_PRICE_SPORTS_BASEBALL=
STRIPE_PRICE_SPORTS_BASKETBALL=
STRIPE_PRICE_SPORTS_FOOTBALL=
STRIPE_PRICE_SPORTS_HOCKEY=
STRIPE_PRICE_SPORTS_SOCCER=
